# ===== CWFLY FastAPI 后端环境变量（与 Node 版同名，可直接复用现有 .env）=====
NODE_ENV=development
PORT=3001

# 与 Node 同一个 MySQL 库（表结构不迁移，列名保持 camelCase）
DATABASE_URL=mysql://user:password@127.0.0.1:3306/cwfly
DB_CONNECTION_LIMIT=5

# JWT（过期时间默认 6 小时；活跃时由中间件滑动续期）
JWT_SECRET=
JWT_EXPIRES=12h
JWT_MAX_SESSION_SECONDS=43200
JWT_REFRESH_GRACE_SECONDS=1800
JWT_REFRESH_BEFORE_SECONDS=120

# CORS（生产必须显式设置）
CORS_ORIGIN=https://www.cwflysim.cn

# 首次启动创建管理员（已存在则忽略）
ADMIN_PASSWORD=

# 邮件（SMTP）
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CW 模拟飞行
FRONTEND_URL=https://www.cwflysim.cn

# Login security / verification (optional; defaults shown)
VERIFY_CODE_TTL_SECONDS=600
VERIFY_CODE_MAX_ATTEMPTS=5
VERIFY_SEND_COOLDOWN_SECONDS=60
LOGIN_CHALLENGE_TTL_SECONDS=600
TRUSTED_IP_LOGIN_HISTORY=50
TRUSTED_DEVICE_TTL_SECONDS=2592000
# 审计日志：记录所有 /api 操作
AUDIT_LOG_ALL_REQUESTS=true
AUDIT_LOG_RETENTION_DAYS=180
# 服务端安全事件/登录失败记录永久保留（不自动删除）
LOG_RETENTION_DISABLED=1
# 可选：备份 GPG 对称加密密钥文件（600；留空则保留明文 .sql.gz）
BACKUP_GPG_PASSPHRASE_FILE=
LOGIN_LOCK_WINDOW_MINUTES=15
LOGIN_LOCK_MAX_FAILS=5

# 第三方
OPENAPI_KEY=
TURNSTILE_SECRET_KEY=
FSD_WHAZZUP_FILE=/opt/cwfly/fsd-py/whazzup.txt
FSD_SYS_CID=
FSD_SYS_PASSWORD=

# ===== OAuth2 授权服务器（供 Dubhe Nexus / Merak 绑定 CWFLY 账号）=====
# 留空 CLIENT_ID / CLIENT_SECRET 时 /api/oauth/* 返回 503，不影响其它功能。
OAUTH2_ENABLED=true
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_CLIENT_NAME=Dubhe Nexus
# 回调地址白名单（逗号分隔，精确匹配；填 Merak 侧注册的 redirect_uri）
OAUTH2_REDIRECT_URIS=
OAUTH2_SCOPES=profile email qq openid
OAUTH2_CODE_TTL_SECONDS=300
OAUTH2_TOKEN_TTL_SECONDS=3600
OAUTH2_REFRESH_TTL_SECONDS=2592000
# 对外站点根地址（拼头像 URL / 登录回跳），留空回退 CORS_ORIGIN
OAUTH2_ISSUER=
