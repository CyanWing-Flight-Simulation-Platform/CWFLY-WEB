# ===== CWFLY FastAPI 后端环境变量（与 Node 版同名，可直接复用现有 .env）=====
NODE_ENV=development
PORT=3001

# 与 Node 同一个 MySQL 库（表结构不迁移，列名保持 camelCase）
DATABASE_URL=mysql://user:password@127.0.0.1:3306/cwfly
DB_CONNECTION_LIMIT=5

# JWT（过期时间默认 6 小时；活跃时由中间件滑动续期）
JWT_SECRET=
JWT_EXPIRES=12h
JWT_MAX_SESSION_SECONDS=43200
JWT_REFRESH_GRACE_SECONDS=1800
JWT_REFRESH_BEFORE_SECONDS=120

# CORS（生产必须显式设置）
CORS_ORIGIN=https://www.cwflysim.cn

# 首次启动创建管理员（已存在则忽略）
ADMIN_PASSWORD=

# 邮件（SMTP）
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CW 模拟飞行
FRONTEND_URL=https://www.cwflysim.cn

# Login security / verification (optional; defaults shown)
VERIFY_CODE_TTL_SECONDS=600
VERIFY_CODE_MAX_ATTEMPTS=5
VERIFY_SEND_COOLDOWN_SECONDS=60
LOGIN_CHALLENGE_TTL_SECONDS=600
TRUSTED_IP_LOGIN_HISTORY=50
TRUSTED_DEVICE_TTL_SECONDS=2592000
# 审计日志：记录所有 /api 操作
AUDIT_LOG_ALL_REQUESTS=true
AUDIT_LOG_RETENTION_DAYS=180
LOGIN_LOCK_WINDOW_MINUTES=15
LOGIN_LOCK_MAX_FAILS=5

# 第三方
OPENAPI_KEY=
TURNSTILE_SECRET_KEY=
FSD_WHAZZUP_FILE=/opt/cwfly/fsd-py/whazzup.txt
FSD_SYS_CID=
FSD_SYS_PASSWORD=
